resource "google_compute_instance" "default" {
  project      = "qwiklabs-gcp-04-73312f974bd6"
  zone         = "us-east1-b"
  name         = "terraform"
  machine_type = "e2-medium"
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
    }
  }
  network_interface {
    network = "default"
    access_config {
    }
  }
}
